# Copy to /etc/external-disk-backup/<name>.env and edit.

# Where the removable disk is mounted.
BACKUP_TARGET=/mnt/backup

# The file that proves the disk is actually mounted. Create it ON THE DISK
# once, by hand:  touch /mnt/backup/.backup-target
#
# It is the whole safety mechanism. Without it, an unmounted mount point is an
# ordinary empty directory on the root filesystem, and a backup written there
# fills the disk it was supposed to protect while reporting success.
BACKUP_MARKER=.backup-target

# What to copy. Space or newline separated. Each one lands under the target as
# its basename, so /mnt/storage/photos becomes /mnt/backup/photos.
BACKUP_SOURCES="/mnt/storage/photos /mnt/storage/documents /var/lib/app/backups"

# How long deleted and overwritten files stay in _trash/<date>/. This is what
# makes it a backup rather than a mirror: without it, a file deleted by mistake
# is gone from the copy on the next run. Set to 0 to keep them forever, and
# then watch the disk.
BACKUP_TRASH_DAYS=30

# Extra rsync arguments, e.g. --exclude='*.tmp' --bwlimit=20M
#
# THE VERIFICATION USES THESE TOO, which is what makes an exclusion usable.
# The case people actually want is a media library: take the artwork, the
# playlists and the database, leave the video where it already is.
#
#   BACKUP_RSYNC_EXTRA=--exclude='*.mkv' --exclude='*.mp4' --exclude='*.iso'
#
# Without the verification honouring the same list, every excluded file would
# be reported as missing from the backup on every run — thousands of findings,
# all of them this setting working.
BACKUP_RSYNC_EXTRA=

BACKUP_STATE_DIR=/var/lib/external-disk-backup
